# 이 파일을 복사해 이름을 .env.local 로 바꾼 뒤 값을 채우세요.
# (서버를 한 번 실행하면 .env.local 이 자동으로 만들어지기도 합니다)

# ╔══════════════════════════════════════════════════════╗
# ║  Gmail로 보내기 — 누구에게나 발송 가능 (권장)       ║
# ╚══════════════════════════════════════════════════════╝
GMAIL_USER=
GMAIL_APP_PASSWORD=
ENABLE_EMAIL_AUTH=false

# ── 또는 Resend ── (도메인 인증 전에는 Resend 가입 메일로만 발송됩니다)
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev

# 인증 티켓 암호화 키 — 비워 두면 서버가 알아서 채웁니다
AUTH_SECRET=
